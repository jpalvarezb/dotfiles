# Ghostty config — managed in ~/.dotfiles (symlinked to ~/.config/ghostty/config)
# Docs: https://ghostty.org/docs/config
# Reload after edits: Cmd+Shift+, (or quit + reopen)

# ── Font ──────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = true

# ── Theme ─────────────────────────────────────────────────────
# Swap freely: Catppuccin Macchiato, Gruvbox Material, Nord, Ayu Mirage, etc.
# See all: `open /Applications/Ghostty.app/Contents/Resources/ghostty/themes`
theme = "Brogrammer"

# ── App icon (monochrome / black & white) ─────────────────────
# custom-style lets us recolor the ghost + screen; chrome frame = neutral silver.
# White ghost on a black screen = sleek B&W. Flip the two colors for the inverse.
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = white
macos-icon-screen-color = black

# ── Window ────────────────────────────────────────────────────
# See-through, but blurred so text stays readable ("frosted glass").
# opacity 1.0 = solid, lower = more transparent. blur softens whatever's behind.
background-opacity = 0.85
background-blur-radius = 30
window-padding-x = 10
window-padding-y = 8
window-save-state = always
macos-titlebar-style = tabs

# ── Cursor ────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Behavior ──────────────────────────────────────────────────
macos-option-as-alt = true
copy-on-select = true
mouse-hide-while-typing = true

# ── Splits (for running multiple Claude Code sessions side by side) ──
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+left_bracket=goto_split:previous
keybind = cmd+right_bracket=goto_split:next
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# ── Tabs = ventanas de tmux ───────────────────────────────────
# Los tabs nativos de macOS confunden a AeroSpace (cada tab es una window real).
# Estos atajos mandan el prefijo de tmux en su lugar: Cmd+T = window nueva,
# Cmd+1..9 = saltar directo. Fuera de tmux solo mandan un Ctrl-b inofensivo.
keybind = cmd+t=text:\x02c
keybind = cmd+one=text:\x021
keybind = cmd+two=text:\x022
keybind = cmd+three=text:\x023
keybind = cmd+four=text:\x024
keybind = cmd+five=text:\x025
keybind = cmd+six=text:\x026
keybind = cmd+seven=text:\x027
keybind = cmd+eight=text:\x028
keybind = cmd+nine=text:\x029
