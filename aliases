# Launch a tmux session split into 4 tiled panes — one per parallel Claude Code run.
# Usage:  cd <project> && ccgrid   (detach with Ctrl-b d, reattach with `tmux attach -t claude`)
ccgrid() {
  local session="claude"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux attach -t "$session"; return
  fi
  tmux new-session -d -s "$session" -c "$PWD"
  tmux split-window -h -c "$PWD"
  tmux split-window -v -c "$PWD"
  tmux select-pane -t 0
  tmux split-window -v -c "$PWD"
  tmux select-layout tiled
  tmux select-pane -t 0
  tmux attach -t "$session"
}

# Claude Squad — manage parallel Claude Code agents, each in its own git worktree.
# Run `cs` inside a git repo. Config: ~/.claude-squad/config.json
alias cs="claude-squad"
