#!/usr/bin/env python3
"""Generate an interactive knowledge graph of recent Claude Code activity.

Parses ~/.claude/projects/*/*.jsonl transcripts (last N days) and emits a
self-contained HTML file (no external assets — safe for Notion's HTML upload).
Nodes: projects, sessions, files. Files touched by 2+ sessions are highlighted:
that IS the implicitly-shared context between agents.

Usage: claude-graph [days] [output.html]
"""
import json
import sys
import time
from collections import Counter
from pathlib import Path

DAYS = int(sys.argv[1]) if len(sys.argv) > 1 else 7
OUT = Path(sys.argv[2]) if len(sys.argv) > 2 else Path.home() / ".claude/graph/claude-graph.html"
ROOT = Path.home() / ".claude/projects"
CUTOFF = time.time() - DAYS * 86400
MAX_FILES_PER_PROJECT = 25

def project_name(folder: str) -> str:
    for prefix in ("-Users-jpalvarez-code-projects-", "-Users-jpalvarez-code-", "-Users-jpalvarez-"):
        if folder.startswith(prefix) and len(folder) > len(prefix):
            return folder[len(prefix):]
    return "home" if folder == "-Users-jpalvarez" else folder.lstrip("-")

sessions = {}  # sid -> dict
for jl in ROOT.glob("*/*.jsonl"):
    if jl.stat().st_mtime < CUTOFF:
        continue
    proj = project_name(jl.parent.name)
    sid = jl.stem
    s = {"project": proj, "files": Counter(), "tools": Counter(),
         "msgs": 0, "agents": 0, "first": None, "last": None}
    try:
        with open(jl, errors="replace") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                ts = d.get("timestamp")
                if ts:
                    s["first"] = min(s["first"] or ts, ts)
                    s["last"] = max(s["last"] or ts, ts)
                msg = d.get("message") or {}
                content = msg.get("content")
                if d.get("type") == "user":
                    s["msgs"] += 1
                if not isinstance(content, list):
                    continue
                for block in content:
                    if not isinstance(block, dict) or block.get("type") != "tool_use":
                        continue
                    name = block.get("name", "?")
                    s["tools"][name] += 1
                    if name in ("Agent", "Task"):
                        s["agents"] += 1
                    inp = block.get("input") or {}
                    fp = inp.get("file_path") or inp.get("notebook_path")
                    if fp:
                        s["files"][fp] += 1
    except OSError:
        continue
    if s["tools"] or s["msgs"]:
        sessions[sid] = s

# ── build graph ────────────────────────────────────────────────
projects = sorted({s["project"] for s in sessions.values()})
file_sessions = {}  # path -> set(sid)
for sid, s in sessions.items():
    for fp in s["files"]:
        file_sessions.setdefault(fp, set()).add(sid)

# keep the most-touched files per project so the graph stays readable
kept_files = set()
for proj in projects:
    proj_files = Counter()
    for sid, s in sessions.items():
        if s["project"] == proj:
            proj_files.update(s["files"])
    kept_files.update(fp for fp, _ in proj_files.most_common(MAX_FILES_PER_PROJECT))

nodes, edges, idx = [], [], {}
def add(node):
    idx[node["id"]] = len(nodes)
    nodes.append(node)

for i, proj in enumerate(projects):
    n_sess = sum(1 for s in sessions.values() if s["project"] == proj)
    add({"id": f"p:{proj}", "kind": "project", "label": proj, "ci": i, "n": n_sess})
for sid, s in sessions.items():
    date = (s["first"] or "")[:16].replace("T", " ")
    top = ", ".join(f"{t}×{c}" for t, c in s["tools"].most_common(4))
    add({"id": f"s:{sid}", "kind": "session", "label": date or sid[:8],
         "ci": projects.index(s["project"]), "n": sum(s["tools"].values()),
         "tip": f"{s['project']} · {date} · {s['msgs']} msgs · {s['agents']} agentes · {top}"})
    edges.append([f"p:{s['project']}", f"s:{sid}", 1])
for fp in kept_files:
    sids = file_sessions[fp]
    shared = len(sids) > 1
    add({"id": f"f:{fp}", "kind": "file", "label": Path(fp).name,
         "shared": shared, "n": len(sids), "tip": fp})
    for sid in sids:
        if f"s:{sid}" in idx:
            edges.append([f"s:{sid}", f"f:{fp}", sessions[sid]["files"][fp]])

edges = [[idx[a], idx[b], w] for a, b, w in edges if a in idx and b in idx]
shared_count = sum(1 for n in nodes if n.get("shared"))
data = json.dumps({"nodes": nodes, "edges": edges, "days": DAYS,
                   "generated": time.strftime("%Y-%m-%d %H:%M")}, ensure_ascii=False)

HTML = r"""<!doctype html><html><head><meta charset="utf-8">
<title>Claude Agents Graph</title>
<style>
  html,body{margin:0;height:100%;background:#131313;color:#d6dbe5;
    font:13px/1.4 "JetBrainsMono NFM","JetBrains Mono",monospace;overflow:hidden}
  #hud{position:fixed;top:12px;left:16px;pointer-events:none}
  #hud h1{margin:0;font-size:15px;color:#ecba0f}
  #hud .sub{color:#666c76}
  #legend{position:fixed;bottom:12px;left:16px;color:#666c76;pointer-events:none}
  #legend b{font-weight:normal}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin:0 4px 0 10px}
  #tip{position:fixed;display:none;background:#1f1f1f;border:1px solid #2a84d2;
    padding:6px 9px;border-radius:6px;max-width:420px;pointer-events:none;z-index:9}
  canvas{display:block}
</style></head><body>
<div id="hud"><h1>⏺ Claude Agents Graph</h1><div class="sub" id="stats"></div></div>
<div id="legend"><b><span class="dot" style="background:#2a84d2"></span>proyecto
<span class="dot" style="background:#ecba0f"></span>sesión
<span class="dot" style="background:#2dc55e"></span>archivo
<span class="dot" style="background:#f81118"></span>archivo compartido entre sesiones</b>
&nbsp;·&nbsp; arrastra nodos · hover para detalle</div>
<div id="tip"></div><canvas id="c"></canvas>
<script>
const DATA = __DATA__;
const PAL=["#2a84d2","#2dc55e","#ecba0f","#5350b9","#1081d6","#de352e","#1dd361","#f3bd09","#4e5ab7","#0f7ddb"];
const cv=document.getElementById("c"),cx=cv.getContext("2d"),tip=document.getElementById("tip");
let W,H,DPR=devicePixelRatio||1;
function resize(){W=innerWidth;H=innerHeight;cv.width=W*DPR;cv.height=H*DPR;
  cv.style.width=W+"px";cv.style.height=H+"px";cx.setTransform(DPR,0,0,DPR,0,0)}
resize();addEventListener("resize",resize);
const N=DATA.nodes,E=DATA.edges;
N.forEach((n,i)=>{const a=i/N.length*Math.PI*2,r=Math.min(W,H)*.33;
  n.x=W/2+Math.cos(a)*r*(n.kind==="project"?.4:1);
  n.y=H/2+Math.sin(a)*r*(n.kind==="project"?.4:1);n.vx=0;n.vy=0;
  n.r=n.kind==="project"?14+Math.min(10,n.n):n.kind==="session"?5+Math.min(6,Math.sqrt(n.n)):3+Math.min(4,n.n);
  n.color=n.kind==="file"?(n.shared?"#f81118":"#2dc55e"):PAL[n.ci%PAL.length]});
const stats=document.getElementById("stats");
stats.textContent=`últimos ${DATA.days} días · ${N.filter(n=>n.kind==="project").length} proyectos · `+
 `${N.filter(n=>n.kind==="session").length} sesiones · ${N.filter(n=>n.kind==="file").length} archivos `+
 `(${N.filter(n=>n.shared).length} compartidos) · generado ${DATA.generated}`;
let drag=null,hover=null,mx=0,my=0;
cv.onmousedown=e=>{if(hover){drag=hover;drag.fx=e.clientX;drag.fy=e.clientY}};
addEventListener("mouseup",()=>{if(drag){drag.fx=drag.fy=null;drag=null}});
addEventListener("mousemove",e=>{mx=e.clientX;my=e.clientY;
  if(drag){drag.fx=mx;drag.fy=my}
  hover=null;
  for(const n of N){const dx=n.x-mx,dy=n.y-my;if(dx*dx+dy*dy<(n.r+4)**2){hover=n;break}}
  if(hover&&(hover.tip||hover.label)){tip.style.display="block";
    tip.style.left=Math.min(mx+14,W-440)+"px";tip.style.top=(my+14)+"px";
    tip.textContent=hover.tip||hover.label}else tip.style.display="none"});
function step(){
  for(let i=0;i<N.length;i++)for(let j=i+1;j<N.length;j++){
    const a=N[i],b=N[j];let dx=b.x-a.x,dy=b.y-a.y,d2=dx*dx+dy*dy||1;
    if(d2<32000){const f=900/d2,d=Math.sqrt(d2);dx/=d;dy/=d;
      a.vx-=dx*f;a.vy-=dy*f;b.vx+=dx*f;b.vy+=dy*f}}
  for(const[i,j]of E){const a=N[i],b=N[j];
    const dx=b.x-a.x,dy=b.y-a.y,d=Math.sqrt(dx*dx+dy*dy)||1;
    const f=(d-60)*.004;a.vx+=dx/d*f*d;a.vy+=dy/d*f*d;b.vx-=dx/d*f*d;b.vy-=dy/d*f*d}
  for(const n of N){n.vx+=(W/2-n.x)*.0012;n.vy+=(H/2-n.y)*.0012;
    n.vx*=.85;n.vy*=.85;n.x+=n.vx;n.y+=n.vy;
    if(n.fx!=null){n.x=n.fx;n.y=n.fy}}
}
function draw(){cx.clearRect(0,0,W,H);
  cx.strokeStyle="rgba(214,219,229,.10)";
  for(const[i,j,w]of E){cx.lineWidth=Math.min(2.5,.5+w*.1);cx.beginPath();
    cx.moveTo(N[i].x,N[i].y);cx.lineTo(N[j].x,N[j].y);cx.stroke()}
  for(const n of N){cx.beginPath();cx.arc(n.x,n.y,n.r,0,7);
    cx.fillStyle=n.color;cx.shadowColor=n.color;cx.shadowBlur=n===hover?18:(n.shared?12:6);
    cx.fill();cx.shadowBlur=0;
    if(n.kind==="project"){cx.fillStyle="#d6dbe5";cx.font="bold 12px monospace";
      cx.fillText(n.label,n.x+n.r+5,n.y+4)}}
}
(function loop(){step();step();draw();requestAnimationFrame(loop)})();
</script></body></html>"""

OUT.parent.mkdir(parents=True, exist_ok=True)
OUT.write_text(HTML.replace("__DATA__", data))
print(f"{OUT}  ({OUT.stat().st_size//1024} KB)")
print(f"proyectos={len(projects)} sesiones={len(sessions)} "
      f"archivos={len(kept_files)} compartidos={shared_count} edges={len(edges)}")
