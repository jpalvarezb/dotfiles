#!/usr/bin/env python3
"""claude-top — live view of Claude Code agents on this machine.

Scans ~/.claude/projects/*/*.jsonl and shows, refreshing every 2s, which
sessions are alive, on which project, and the last action each one took.
● green = active in the last 90s · ○ steel = idle · rows sorted by recency.
"""
import json
import time
from pathlib import Path

ROOT = Path.home() / ".claude/projects"
WINDOW = 30 * 60          # show sessions touched in the last 30 min
ACTIVE = 90               # "live" threshold in seconds
TAIL = 32_768             # bytes to read from the end of each transcript

GOLD, GREEN, STEEL, DIM, INK, RESET = ("\033[38;2;217;164;65m", "\033[38;2;47;174;95m",
    "\033[38;2;95;108;125m", "\033[38;2;62;74;89m", "\033[38;2;201;212;227m", "\033[0m")

def project_name(folder: str) -> str:
    for prefix in ("-Users-jpalvarez-code-projects-", "-Users-jpalvarez-code-", "-Users-jpalvarez-"):
        if folder.startswith(prefix) and len(folder) > len(prefix):
            return folder[len(prefix):].split("--claude-worktrees")[0]
    return "home" if folder == "-Users-jpalvarez" else folder.lstrip("-")

def last_action(path: Path) -> str:
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, path.stat().st_size - TAIL))
            lines = fh.read().decode(errors="replace").splitlines()
    except OSError:
        return "?"
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        msg = d.get("message") or {}
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for b in reversed(content):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use":
                name, inp = b.get("name", "?"), b.get("input") or {}
                arg = (Path(inp["file_path"]).name if inp.get("file_path")
                       else (inp.get("command") or "")[:38]
                       or (inp.get("description") or "")[:38]
                       or (inp.get("pattern") or "")[:30])
                return f"{name} {arg}".strip()
            if b.get("type") == "text" and d.get("type") == "assistant":
                return "respondiendo…"
        if d.get("type") == "user":
            return "turno del usuario"
    return "—"

def fmt_age(s: float) -> str:
    return f"{int(s)}s" if s < 60 else f"{int(s // 60)}m" if s < 3600 else f"{int(s // 3600)}h"

try:
    while True:
        now = time.time()
        rows = []
        for jl in ROOT.glob("*/*.jsonl"):
            age = now - jl.stat().st_mtime
            if age < WINDOW:
                rows.append((age, project_name(jl.parent.name), jl))
        rows.sort()
        out = ["\033[2J\033[H" + f"{GOLD}⏺ CLAUDE OPS{RESET}  {DIM}agentes en esta máquina · "
               f"{sum(1 for a, *_ in rows if a < ACTIVE)} activos · {time.strftime('%H:%M:%S')}{RESET}", ""]
        if not rows:
            out.append(f"{STEEL}  sin actividad en los últimos 30 min{RESET}")
        for age, proj, jl in rows[:14]:
            live = age < ACTIVE
            dot, c = ("●", GREEN) if live else ("○", STEEL)
            out.append(f"  {c}{dot}{RESET} {INK}{proj[:22]:<22}{RESET} {DIM}{jl.stem[:8]}{RESET} "
                       f"{c}{fmt_age(age):>4}{RESET}  {INK if live else STEEL}{last_action(jl)[:52]}{RESET}")
        print("\n".join(out), flush=True)
        time.sleep(2)
except KeyboardInterrupt:
    pass
