{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "agents-sdk": "off",
    "brandkit": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "design-taste-frontend": "off",
    "design-taste-frontend-v1": "off",
    "durable-objects": "off",
    "full-output-enforcement": "off",
    "high-end-visual-design": "off",
    "image-to-code": "off",
    "imagegen-frontend-mobile": "off",
    "imagegen-frontend-web": "off",
    "industrial-brutalist-ui": "off",
    "minimalist-ui": "off",
    "sandbox-sdk": "off",
    "stitch-design-taste": "off",
    "turnstile-spin": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code is waiting for your input\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your input\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/jpalvarez/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "notion@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
